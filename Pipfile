[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[requires]
python_version = "3.11"

[packages]
django = "==5.2.13"  # Parche de seguridad
djangorestframework = "==3.17.1"  # Versión parcheada
mysqlclient = "2.2"  # Soporte para MySQL
python-decouple = "3.8"  # Gestión de variables de entorno
django-cors-headers = "==4.9.0"  # Manejo de CORS (actualizado)
drf-spectacular = "*"
setuptools = "==82.0.1"
wheel = "==0.46.3"

[dev-packages]
pytest = "*"
pytest-django = "4.8.0"  # Compatible con Django 5.x
pytest-cov = "*"
black = "==26.3.1"  # Formateador de código (actualizado)
isort = "==8.0.1"  # Organización de imports (actualizado)
pip-audit = "*"
safety = "*"
pipdeptree = "*"
pip-licenses = "*"

[scripts]
start = "python manage.py runserver"
migrate = "python manage.py migrate"
createsuperuser = "python manage.py createsuperuser"
